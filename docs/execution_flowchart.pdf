T*
(   Then: update_memory -> mark_processed -> END) Tj
T*
() Tj
T*
(3. human_review) Tj
T*
(   Reason: low confidence, VIP sender, or sensitive content) Tj
T*
(   Flow: human_review -> Human decision) Tj
T*
(   - approve -> send_or_save) Tj
T*
(   - revise -> revise_reply -> human_review) Tj
T*
(   - reject -> update_memory) Tj
T*
(   Then: mark_processed -> END) Tj
T*
