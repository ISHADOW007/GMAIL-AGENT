OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

AUTO_SEND=false
MAX_EMAILS=5

# Gmail API settings
GMAIL_USER_ID=me
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=data/gmail_token.json
GMAIL_OPEN_BROWSER=false
GMAIL_LABEL_PREFIX=AI

# Optional override for the From header on replies
DEFAULT_FROM_ADDRESS=

# Optional MongoDB-backed LangGraph persistence
MONGODB_URI=
MONGODB_DATABASE=email_agent
MONGODB_STORE_COLLECTION=long_term_memory
MONGODB_MEMORY_NAMESPACE=email_agent
