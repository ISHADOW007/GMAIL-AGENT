OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini

EMAIL_BACKEND=local
AUTO_SEND=false
MAX_EMAILS=5

# Used by the local demo backend.
LOCAL_INBOX_PATH=data/sample_inbox.json
LOCAL_OUTBOX_PATH=data/outbox.json

# Used by the Gmail API backend.
GMAIL_USER_ID=me
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=data/gmail_token.json
GMAIL_OPEN_BROWSER=false
GMAIL_LABEL_PREFIX=AI

# Used by the IMAP/SMTP backend.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=you@example.com
IMAP_PASSWORD=app_password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=app_password
DEFAULT_FROM_ADDRESS=you@example.com

# Optional MongoDB memory store.
MONGODB_URI=
MONGODB_DATABASE=email_agent
